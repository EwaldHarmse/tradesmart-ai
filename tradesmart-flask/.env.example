# Copy this file to .env and fill in your own values.

# --- Database (see README.md) ---
DB_ENABLED=true
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=TradeSmartAI
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=

# --- Flask ---
# Any random string - used to sign the session cookie that holds the
# in-progress chat state. Change this for anything beyond local dev.
SECRET_KEY=change-me

# PORT=5000
# HOST=127.0.0.1
# NO_BROWSER=1
# FLASK_DEBUG=1   # local development only - never on a shared network
